diff --git a/codex-rs/app-server/src/thread_state.rs b/codex-rs/app-server/src/thread_state.rs
index a19c41b..3a2ac67 100644
--- a/codex-rs/app-server/src/thread_state.rs
+++ b/codex-rs/app-server/src/thread_state.rs
@@ -187,0 +188,8 @@ impl ThreadState {
+    pub(crate) fn has_in_progress_turn(&self) -> bool {
+        // History deliberately retains an interrupted terminal turn until the
+        // next start. active_turn_id() also falls back to the last finished
+        // turn, so ID presence is not an execution-status predicate.
+        self.active_turn_metadata_snapshot()
+            .is_some_and(|turn| turn.status == codex_app_server_protocol::TurnStatus::InProgress)
+    }
+
@@ -271,0 +280,33 @@ mod tests {
+    #[test]
+    fn retained_interrupted_turn_is_not_an_in_progress_turn() {
+        let mut state = ThreadState::default();
+        assert!(!state.has_in_progress_turn());
+        state.track_current_turn_event(
+            "turn-1",
+            &EventMsg::TurnStarted(codex_protocol::protocol::TurnStartedEvent {
+                turn_attribution: None,
+                turn_id: "turn-1".to_string(),
+                root_turn_id: None,
+                trace_id: None,
+                started_at: None,
+                model_context_window: None,
+                collaboration_mode_kind: Default::default(),
+            }),
+        );
+        assert!(state.has_in_progress_turn());
+        state.track_current_turn_event(
+            "turn-1",
+            &EventMsg::TurnAborted(codex_protocol::protocol::TurnAbortedEvent {
+                root_turn_id: None,
+                turn_id: Some("turn-1".to_string()),
+                started_at: None,
+                reason: codex_protocol::protocol::TurnAbortReason::Interrupted,
+                error: None,
+                completed_at: None,
+                duration_ms: None,
+            }),
+        );
+        assert_eq!(state.active_turn_id(), Some("turn-1"));
+        assert!(!state.has_in_progress_turn());
+    }
