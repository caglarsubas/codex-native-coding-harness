# Optional, server-side Planeon inference. Copy to .env and chmod 600 .env.
# No shell expansion is performed. Do not place real credentials here.
# The supplied .planeon/ credential document is ignored, never runtime-loaded.
CODEX_LLM_BASE_URL=https://your-inference-service.example/v1
CODEX_LLM_API_KEY=
CODEX_LLM_MODEL=ministral-3:8b
# Optional separate on-prem model for chat. Omit to use CODEX_LLM_MODEL.
# CODEX_LLM_ASSISTANT_MODEL=qwen3.8:27b
