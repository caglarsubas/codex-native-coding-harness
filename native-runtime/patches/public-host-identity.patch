+async fn read_policy(
+    mcp: &mut TestAppServer,
+    id: &str,
+) -> Result<ThreadEffectivePolicyReadResponse> {
+    let request = mcp
+        .send_request("thread/effectivePolicy/read", Some(json!({"threadId": id})))
+        .await?;
+    let value: serde_json::Value = timeout(
+        std::time::Duration::from_secs(10),
+        mcp.read_response(request),
+    )
+    .await??;
+    Ok(serde_json::from_value(value)?)
+}
+
+#[tokio::test]
+async fn native_policy_read_does_not_load_an_unavailable_thread() -> Result<()> {
+    let home = TempDir::new()?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_auto_env()
+        .build_initialized()
+        .await?;
+    let id = Uuid::new_v4().to_string();
+    for _ in 0..2 {
+        let report = read_policy(&mut mcp, &id).await?;
+        assert_eq!(report.version, 1);
+        assert_eq!(report.thread_id, id);
+        assert!(report.policy.is_none());
+    }
+    let request = mcp
+        .send_thread_loaded_list_request(ThreadLoadedListParams {
+            cursor: None,
+            limit: None,
+        })
+        .await?;
+    let value: serde_json::Value = timeout(
+        std::time::Duration::from_secs(10),
+        mcp.read_response(request),
+    )
+    .await??;
+    assert!(value["data"].as_array().unwrap().is_empty());
+    Ok(())
+}
