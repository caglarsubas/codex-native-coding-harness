+fn resume_requests_code_mode_off(request: &ThreadResumeParams) -> bool {
+    let Some(config) = request.config.as_ref() else {
+        return false;
+    };
+    // The public config override accepts nested and dotted feature keys.
+    // Detect only an explicit off; absence must not become a denial claim.
+    let value = config
+        .get("features.code_mode.enabled")
+        .or_else(|| config.get("features.code_mode"))
+        .or_else(|| {
+            config
+                .get("features")
+                .and_then(|features| features.get("code_mode"))
+        })
+        .or_else(|| {
+            config
+                .get("features")
+                .and_then(|features| features.get("code_mode.enabled"))
+        });
+    value.is_some_and(|value| {
+        value.as_bool() == Some(false)
+            || value.get("enabled").and_then(serde_json::Value::as_bool) == Some(false)
+    })
+}
