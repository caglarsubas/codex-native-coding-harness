diff --git a/codex-rs/app-server/tests/suite/v2/thread_subscribe.rs b/codex-rs/app-server/tests/suite/v2/thread_subscribe.rs
new file mode 100644
index 0000000..3a1a1f9
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/thread_subscribe.rs
@@ -0,0 +1,89 @@
+//! Subscribe-only must not silently restore an unloaded persisted thread.
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::create_fake_rollout;
+use app_test_support::create_mock_responses_server_repeating_assistant;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::ThreadSubscribeParams;
+use serde_json::json;
+use tempfile::TempDir;
+
+#[test]
+fn subscribe_only_request_rejects_load_and_policy_fields() {
+    for field in [
+        "load",
+        "config",
+        "sandbox",
+        "approvalPolicy",
+        "excludeTurns",
+    ] {
+        let mut request = json!({"threadId":"00000000-0000-4000-8000-000000000001"});
+        request[field] = json!(true);
+        assert!(serde_json::from_value::<ThreadSubscribeParams>(request).is_err());
+    }
+}
+
+#[tokio::test]
+async fn subscribe_only_loaded_thread_without_resume_or_provider_request() -> Result<()> {
+    let server = create_mock_responses_server_repeating_assistant("unused").await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri()).write(home.path())?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let thread = mcp.start_thread(ThreadStartParams::default()).await?.thread;
+    let request = mcp
+        .send_request("thread/subscribe", Some(json!({"threadId":thread.id})))
+        .await?;
+    let response: serde_json::Value = mcp.read_response(request).await?;
+    assert_eq!(
+        response,
+        json!({"version":1,"threadId":thread.id,"subscribed":true,"reloaded":false})
+    );
+    assert!(
+        server
+            .received_requests()
+            .await
+            .unwrap()
+            .iter()
+            .all(|r| !r.url.path().ends_with("responses"))
+    );
+    Ok(())
+}
+
+#[tokio::test]
+async fn subscribe_only_persisted_unloaded_thread_refuses_without_load() -> Result<()> {
+    let home = TempDir::new()?;
+    let id = create_fake_rollout(
+        home.path(),
+        "2026-10-18T00-00-00",
+        "2026-10-18T00:00:00Z",
+        "fixture",
+        None,
+        None,
+    )?;
+    let mut mcp = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_auto_env()
+        .build_initialized()
+        .await?;
+    let request = mcp
+        .send_request("thread/subscribe", Some(json!({"threadId":id})))
+        .await?;
+    let error = mcp
+        .read_stream_until_error_message(RequestId::Integer(request))
+        .await?;
+    assert!(error.error.message.contains("not loaded"));
+    let request = mcp
+        .send_request(
+            "thread/read",
+            Some(json!({"threadId":id,"includeTurns":false})),
+        )
+        .await?;
+    let response: serde_json::Value = mcp.read_response(request).await?;
+    assert_eq!(response["thread"]["status"], json!({"type":"notLoaded"}));
+    Ok(())
+}
diff --git a/docs/no-reload-subscription.md b/docs/no-reload-subscription.md
new file mode 100644
index 0000000..8694d5a
--- /dev/null
+++ b/docs/no-reload-subscription.md
@@ -0,0 +1,18 @@
+# Experimental subscribe-only operation
+
+This operator-reviewed source-build extension is not a claimed stock Codex API.
+`thread/subscribe` takes exactly `{threadId}` and requires experimental API opt-in.
+It returns `{version:1, threadId, subscribed:true, reloaded:false}` only for an
+already-loaded idle runtime. The pending-unload lock spans the in-memory lookup
+and subscriber insertion; no cold resume or history reconstruction is called.
+Active/approval-wait, unloading, absent and unloaded threads refuse. Extra load,
+configuration and policy fields are rejected. The existing listener supplies
+turn/item notifications and native server requests on the same connection.
+
+Subscription changes only connection bookkeeping. It grants no new input/turn,
+policy change, approval response, historical cleanup or usage reset. A lost
+response cannot authorize a retry of an orchestrator control. A client must
+preserve its original attempt and obtain separate exact continuation authority.
+An exited process cannot retain a loaded runtime, and this method does not revive
+one. Qualification on disposable threads is not permission to reload a live brain,
+replace a reviewed host, change bindings or infer current/historical terminal safety.
