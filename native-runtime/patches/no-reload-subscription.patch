diff --git a/codex-rs/app-server/src/request_processors/thread_processor.rs b/codex-rs/app-server/src/request_processors/thread_processor.rs
index 855e4a5..9175c93 100644
--- a/codex-rs/app-server/src/request_processors/thread_processor.rs
+++ b/codex-rs/app-server/src/request_processors/thread_processor.rs
@@ -571,0 +572,69 @@ impl ThreadRequestProcessor {
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "subscribe-only registration must serialize against pending unloads"
+    )]
+    pub(crate) async fn thread_subscribe(
+        &self,
+        request_id: &ConnectionRequestId,
+        params: codex_app_server_protocol::ThreadSubscribeParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let thread_id = ThreadId::from_string(&params.thread_id)
+            .map_err(|err| invalid_request(format!("invalid thread id: {err}")))?;
+        // Hold the same unload mutex from lookup through subscriber insertion.
+        // A preflight read followed by thread/resume is NOT equivalent: that
+        // would race unloading and could silently reconstruct a runtime.
+        let (thread, state) = {
+            let pending = self.pending_thread_unloads.lock().await;
+            if pending.contains(&thread_id) {
+                return Err(invalid_request(
+                    "thread is unloading; subscribe does not reload",
+                ));
+            }
+            let thread = self
+                .thread_manager
+                .get_thread(thread_id)
+                .await
+                .map_err(|_| invalid_request("thread is not loaded; subscribe does not reload"))?;
+            let status = self
+                .thread_watch_manager
+                .loaded_status_for_thread(&params.thread_id)
+                .await;
+            let state = self.thread_state_manager.thread_state(thread_id).await;
+            if !matches!(status, codex_app_server_protocol::ThreadStatus::Idle)
+                || matches!(
+                    thread.agent_status().await,
+                    AgentStatus::Running | AgentStatus::Shutdown | AgentStatus::NotFound
+                )
+                || state.lock().await.active_turn_id().is_some()
+            {
+                return Err(invalid_request(
+                    "subscribe requires an already-loaded idle thread",
+                ));
+            }
+            let state = self
+                .thread_state_manager
+                .try_ensure_connection_subscribed(thread_id, request_id.connection_id, false)
+                .await
+                .ok_or_else(|| invalid_request("subscribing connection is closed"))?;
+            (thread, state)
+        };
+        if let Err(error) = self
+            .ensure_listener_task_running(thread_id, thread, state)
+            .await
+        {
+            self.thread_state_manager
+                .unsubscribe_connection_from_thread(thread_id, request_id.connection_id)
+                .await;
+            return Err(error);
+        }
+        Ok(Some(
+            codex_app_server_protocol::ThreadSubscribeResponse {
+                version: 1,
+                thread_id: params.thread_id,
+                subscribed: true,
+                reloaded: false,
+            }
+            .into(),
+        ))
+    }
+
